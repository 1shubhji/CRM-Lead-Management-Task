datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LeadStatus {
  New
  Contacted
  Qualified
  Proposal_Sent @map("Proposal Sent")
  Won
  Lost
}

enum Priority {
  High
  Medium
  Low
}

model Lead {
  id               String     @id @default(uuid()) @db.Uuid
  name             String     @map("lead_name")
  company          String?    @map("company_name")
  phone            String     @unique @map("phone_number")
  email            String     @unique @map("email_address")
  city             String?
  source           String?    @map("lead_source")
  assignedEmployee String?    @map("assigned_employee")
  status           LeadStatus @default(New)
  priority         Priority   @default(Medium)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([name])
  @@index([email])
  @@index([phone])
  @@map("leads")
}
