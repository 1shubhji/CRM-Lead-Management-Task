						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"John Doe\",\n    \"company\": \"Acme Corporation\",\n    \"phone\": \"9876543210\",\n    \"email\": \"john.doe@example.com\",\n    \"city\": \"New York\",\n    \"source\": \"Website\",\n    \"assignedEmployee\": \"Emma Watson\",\n    \"status\": \"New\",\n    \"priority\": \"High\"\n}"
				},
				"url": {
					"raw": "http://localhost:3001/api/leads",
					"protocol": "http",
