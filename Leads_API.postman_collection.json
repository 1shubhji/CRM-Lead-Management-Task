			},
			"response": []
		},
		{
			"name": "Get Leads List (Search, Filter, Sort, Paginate)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:3001/api/leads?search=John&status=New&priority=High&sortBy=createdAt&sortOrder=desc&page=1&limit=10",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "3001",
					"path": [
						"api",
						"leads"
					],
					"query": [
						{
							"key": "search",
							"value": "John",
							"description": "Search term matching Name, Company, Phone or Email"
						},
						{
							"key": "status",
							"value": "New",
							"description": "Filter by status: New, Contacted, Qualified, Proposal Sent, Won, Lost"
						},
						{
							"key": "priority",
							"value": "High",
							"description": "Filter by priority: High, Medium, Low"
						},
						{
							"key": "sortBy",
							"value": "createdAt",
							"description": "Sort database field (default: createdAt)"
						},
						{
							"key": "sortOrder",
							"value": "desc",
							"description": "asc for oldest first, desc for newest first"
						},
						{
							"key": "page",
							"value": "1",
							"description": "Page offset"
						},
						{
							"key": "limit",
							"value": "10",
							"description": "Number of records per page"
						}
					]
				},
				"description": "Retrieves leads using filters, sorting direction, search keywords, and server-side pagination offsets."
			},
			"response": []
		},
